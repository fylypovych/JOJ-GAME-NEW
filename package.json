{
  "name": "joj-game-new",
  "version": "0.0.1.41",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-version-from-commit.cjs",
    "dev": "vite",
    "dev:full": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:invariants": "tsx --test tests/gameInvariants.test.ts tests/playerView.test.ts tests/moveSafety.test.ts tests/rankEngine.test.ts tests/actionValidation.test.ts",
    "test:simulation": "tsx --test tests/simulation.test.ts",
    "test:config": "tsx --test tests/sharedConfigImport.test.ts tests/effectsEngine.test.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:server": "tsx server/index.ts",
    "postinstall": "node scripts/fix-is-generator-function.cjs",
    "setup:git-hooks": "node scripts/install-git-hooks.cjs",
    "sync:version-from-commit": "node scripts/sync-version-from-commit.cjs",
    "set:version": "node scripts/sync-version-from-commit.cjs",
    "check:version-sync": "node scripts/check-version-sync.cjs"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "html2canvas": "^1.4.1",
    "node-persist": "^4.0.4",
    "nodemailer": "^8.0.2",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "overrides": {
    "koa": "2.16.4",
    "rollup": "4.59.0"
  }
}
