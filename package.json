{
  "name": "joj-game-new",
  "version": "0.0.3.48",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-version-from-commit.cjs --no-stage",
    "dev": "vite",
    "dev:full": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check package.json README.md eslint.config.mjs .github/workflows/ci.yml docs/dev/architecture.md docs/ops/runtime-data-policy.md scripts/check-shared-config.ts scripts/check-asset-inventory.ts scripts/check-runtime-data.ts scripts/check-i18n.ts src/ui/AdminPage.tsx src/ui/GameBoardV1.tsx src/ui/admin/index.ts src/ui/admin/hooks/index.ts src/ui/app/networkClients.tsx src/ui/board/index.ts src/ui/i18n-data-ui-uk.ts src/ui/i18n-data-ui-en.ts src/ui/i18n/ui-shell-uk.ts src/ui/i18n/ui-shell-en.ts src/ui/i18n/ui-simulation-uk.ts src/ui/i18n/ui-simulation-en.ts tests/moveSafety.helpers.ts tests/moveSafety.handlers.test.ts tests/moveSafety.turn-rules.test.ts",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:invariants": "tsx --test tests/gameInvariants.test.ts tests/playerView.test.ts tests/moveSafety.handlers.test.ts tests/moveSafety.turn-rules.test.ts tests/rankEngine.test.ts tests/actionValidation.test.ts",
    "test:simulation": "tsx --test tests/simulation.test.ts",
    "test:config": "tsx --test tests/sharedConfigImport.test.ts tests/effectsEngine.test.ts",
    "coverage": "c8 --check-coverage --lines 75 --functions 85 --branches 65 --statements 75 --exclude=tests/** --exclude=scripts/** --exclude=public/** --exclude=database/** --exclude=db/** npm run test:unit",
    "check:shared-config": "tsx scripts/check-shared-config.ts",
    "check:assets": "tsx scripts/check-asset-inventory.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:runtime-data": "tsx scripts/check-runtime-data.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:server": "tsx server/index.ts",
    "postinstall": "node scripts/fix-is-generator-function.cjs",
    "setup:git-hooks": "node scripts/install-git-hooks.cjs",
    "sync:version-from-commit": "node scripts/sync-version-from-commit.cjs",
    "set:version": "node scripts/sync-version-from-commit.cjs",
    "check:version-sync": "node scripts/check-version-sync.cjs",
    "seed:shared-config": "node scripts/seed-shared-config-to-db.cjs",
    "migrate:images": "tsx scripts/migrate-images.ts"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "html2canvas": "^1.4.1",
    "node-persist": "^4.0.4",
    "nodemailer": "^8.0.2",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "^11.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.0.7"
  }
}
