{
  "name": "joj-game-new",
  "version": "0.0.4.33",
  "private": true,
  "type": "module",
  "preferGlobal": true,
  "scripts": {
    "prebuild": "node scripts/sync-version-from-commit.cjs --no-stage",
    "dev": "vite",
    "dev:full": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check package.json docs/content-pages.md docs/ops/release-checklist.md docs/ops/runtime-data-policy.md .github/workflows/ci.yml scripts/check-asset-inventory.ts scripts/check-runtime-data.ts server/routes/content.ts src/content/types.ts src/ui/App.tsx src/ui/admin/tabs/content-pages.tsx src/ui/app/sections-gallery-rules.tsx src/ui/styles/content.css tests/adminGitDeploy.test.ts tests/boardgameTransport.test.ts tests/contentRoutes.test.ts tests/contentThemeStyles.test.ts tests/projectPagesMigration.test.ts",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:invariants": "tsx --test tests/gameInvariants.test.ts tests/playerView.test.ts tests/moveSafety.handlers.test.ts tests/moveSafety.turn-rules.test.ts tests/rankEngine.test.ts tests/actionValidation.test.ts",
    "test:simulation": "tsx --test tests/simulation.test.ts",
    "test:config": "tsx --test tests/sharedConfigImport.test.ts tests/effectsEngine.test.ts",
    "coverage": "c8 --check-coverage --lines 64 --functions 85 --branches 58 --statements 64 --exclude=tests/** --exclude=scripts/** --exclude=public/** --exclude=database/** --exclude=db/** npm run test:unit",
    "check:shared-config": "tsx scripts/check-shared-config.ts",
    "check:assets": "tsx scripts/check-asset-inventory.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:runtime-data": "tsx scripts/check-runtime-data.ts",
    "check:changelog-shas": "node scripts/sync-changelog-shas.cjs --check",
    "sync:changelog-shas": "node scripts/sync-changelog-shas.cjs",
    "check:release": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run coverage && npm run check:shared-config && npm run check:assets && npm run check:i18n && npm run check:runtime-data && npm run check:changelog-shas && npm run check:version-sync && npm run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:server": "tsx server/index.ts",
    "postinstall": "node scripts/fix-is-generator-function.cjs",
    "setup:git-hooks": "node scripts/install-git-hooks.cjs",
    "sync:version-from-commit": "node scripts/sync-version-from-commit.cjs",
    "set:version": "node scripts/sync-version-from-commit.cjs",
    "version:next": "node scripts/release-version.cjs",
    "check:version-sync": "node scripts/check-version-sync.cjs",
    "seed:shared-config": "node scripts/seed-shared-config-to-db.cjs",
    "sync:shared-config-db": "tsx scripts/sync-shared-config-to-db.ts",
    "db:migrate": "tsx scripts/run-db-migrations.ts",
    "admin:create": "tsx scripts/bootstrap-admin.ts",
    "fix:storage-mode-postgres": "tsx scripts/fix-storage-mode-postgres.ts",
    "migrate:images": "tsx scripts/migrate-images.ts",
    "joj": "node scripts/joj-cli.mjs"
  },
  "bin": {
    "joj": "./scripts/joj-cli.mjs"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "html2canvas": "^1.4.1",
    "node-persist": "^4.0.4",
    "nodemailer": "^9.0.5",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "^11.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.0.7"
  },
  "overrides": {
    "@koa/cors": "^5.0.0",
    "cookie": "^0.7.2",
    "socket.io": "^4.8.3",
    "socket.io-parser": "^4.2.7",
    "svelte": "^5.56.8",
    "ws": "^8.21.3"
  }
}
